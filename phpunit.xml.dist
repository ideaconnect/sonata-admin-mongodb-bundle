<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         displayDetailsOnAllIssues="true"
         bootstrap="tests/bootstrap.php"
>
    <testsuites>
        <testsuite name="unit">
            <directory>./tests/</directory>
            <exclude>./tests/Functional</exclude>
        </testsuite>
        <testsuite name="functional">
            <directory>./tests/Functional</directory>
        </testsuite>
    </testsuites>

    <!--
        ignoreDirectDeprecations + ignoreIndirectDeprecations: only count
        deprecations triggered from files in <include> (i.e. our own src/).
        Without these, two vendor-origin deprecations show up on every run:

          * symfony/security-acl's MutableAclInterface implements Serializable
            (deprecated on PHP 8.5+; Symfony will fix in security-acl itself).
          * sonata-project/admin-bundle's ObjectAclManipulator calls
            SplObjectStorage::contains() (deprecated PHP 8.5; upstream's fix).

        We can't fix either from this repository.  ignoreDirectDeprecations
        skips deprecations whose trigger lives outside src/;
        ignoreIndirectDeprecations skips those whose call chain originated
        outside src/.  Combined they leave only deprecations our own code
        is responsible for.
    -->
    <!-- Browser scenarios that click through the inherited Bootstrap interface. adminata
         replaced its CSS and JavaScript, and rewrites the templates in its milestones M3 and M4;
         the group is dropped again there. Excluded by default for the same reason adminata and
         idct/adminata-doctrine-orm-admin-bundle exclude it — running them proves nothing until
         those templates exist. -->
    <groups>
        <exclude>
            <group>legacy-ui</group>
        </exclude>
    </groups>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreDirectDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>
    </source>

    <extensions>
        <bootstrap class="Symfony\Component\Panther\ServerExtension" />
    </extensions>

    <php>
        <ini name="precision" value="8" />
        <server name="PANTHER_WEB_SERVER_DIR" value="./tests/App/public/" />
        <env name="KERNEL_CLASS" value="\IDCT\Adminata\DoctrineMongoDB\Tests\App\AppKernel" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="APP_DEBUG" value="false" />
    </php>
</phpunit>
